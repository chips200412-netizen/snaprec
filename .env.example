# Optional template; the application does NOT automatically read .env or API.txt.
# Load chosen values into the backend process environment yourself.
# Default paths are relative to the project root; do not share your real database.
VIDEO_DB_PATH=var/video_notes.sqlite3
VIDEO_TEMP_ROOT=var/tmp
VIDEO_UPLOAD_ROOT=var/uploads
VIDEO_MEDIA_ROOT=var/media
INSPIRATION_TEMP_ROOT=var/inspiration-recordings
COVER_CACHE_ROOT=var/cover-cache

# Voice is unconfigured by default. Text notes and bookmarks still work.
INSPIRATION_ASR_PROVIDER=http
INSPIRATION_ASR_ENDPOINT=
INSPIRATION_ASR_TOKEN=
INSPIRATION_ASR_MODEL=
INSPIRATION_FFPROBE_PATH=ffprobe
INSPIRATION_FFMPEG_PATH=ffmpeg

# OPTIONAL: actively recorded personal inspiration only; may incur provider fees.
# Set the provider to volcengine_flash and provide your own credentials.
# Leave the three INSPIRATION_ASR_* endpoint/token/model values empty in that mode.
INSPIRATION_VOLC_APP_ID=
INSPIRATION_VOLC_ACCESS_TOKEN=

# Historical video-analysis providers are intentionally omitted from this template.
# The current website does not offer deep analysis or source-audio transcription.
