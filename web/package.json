    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.0",
    "typescript": "5.9.3",
